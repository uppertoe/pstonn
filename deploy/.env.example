# pstonn configuration. Copy to .env on the server (mode 600, gitignored) and
# fill in. DOMAIN is supplied by the server repo's root .env, not here.

# --- Secrets (generate with: openssl rand -hex 32) ---
# Signs the app session cookie. Required when APP_OIDC_ISSUER is set.
SESSION_SECRET=
# Encrypts the stored council session cookie at rest. REQUIRED in production: the
# app refuses to start without it (only a local DEV_IDENTITY_EMAIL run may omit
# it, using a throwaway ephemeral key). Keep it stable, rotating it makes every
# stored session undecryptable and forces all users to re-link.
DATA_ENCRYPTION_KEY=

# --- App login ---
# RECOMMENDED: use the platform forward-auth layer (vps-scaffold-auth). Leave
# APP_OIDC_ISSUER empty; the app trusts the Remote-* headers (verified email,
# any domain, one-time-code login). The app is protected in pstonn.caddy.
# AUTH_LOGOUT_URL is set in docker-compose.yml as https://auth.${DOMAIN}/logout
# (tracks DOMAIN). Only set it here to override.
# AUTH_LOGOUT_URL=
# Alternative: run the app's own OIDC relying party instead of forward-auth by
# setting APP_OIDC_ISSUER (+ client). Leave unset to use forward-auth.
# APP_OIDC_ISSUER=
# APP_OIDC_CLIENT_ID=pstonn
# APP_OIDC_CLIENT_SECRET=
# APP_OIDC_REDIRECT_URI=
# APP_OIDC_SCOPES=openid profile email groups
# APP_ADMIN_GROUPS=admins

# --- Council (City of Stonnington ePermits) OAuth client ---
# Defaults target Stonnington; override only if needed. The client issues NO
# refresh tokens, so no offline_access scope; the redirect is the council SPA's
# own registered callback (we read the code from the 302, never receive it).
# COUNCIL_ISSUER=https://parkingpermits.stonnington.vic.gov.au/idm
# COUNCIL_CLIENT_ID=ePermits.ssp.web
# COUNCIL_API_BASE=https://parkingpermits.stonnington.vic.gov.au/ssp-svc
# COUNCIL_SCOPES=openid profile ePermits.ssp.api.all
# COUNCIL_REDIRECT_URI=https://parkingpermits.stonnington.vic.gov.au/ssp/callback

# --- Session lifecycle (keep-warm + re-authorise bound) ---
# How often keep-warm silent-renews an idle-but-valid session to stop its council
# cookie lapsing. Default 1h45m (conservative; safe to raise, see below).
#
# MEASUREMENT HISTORY — read this before changing anything here.
# An early probe reported "alive at 2h32m, lapsed by 3h48m". That run was invalid:
# it ran on a laptop that slept, so the "idle" it reported was awake-time, not
# wall-clock. The clean re-run (caffeinate, no sleep, one continuously-idled session)
# survived 8h, then 10h, then 12h30m of TRUE idle on authorize-only warms, staying
# alive ~30h from a single login. So >=12h30m is the measured floor; the old
# 2h32m/3h48m numbers are superseded, and so is the assumption that the council runs
# the bare Duende 10h default (it does not — this looks like sliding expiration or a
# longer configured lifetime).
#
# PROD IS SET TO: IDLE_WINDOW=12h, WARM_INTERVAL=6h (2026-08-03).
#
# TRAFFIC, counted honestly (a keep-warm is ONE request; a drift read is THREE).
# Keep-warm is authorize-only and mints no access token, so by the time a drift read
# runs its cached 1h token has always expired and the read costs authorize + token
# exchange + grid. At 500 accounts:
#   drift  @6h : 500 x 3 / 360min = 4.2/min   <- the dominant term
#   warm   @6h : 500 x 1 / 360min = 1.4/min   (partly suppressed: a drift renewal
#                                              bumps updated_at, the warm clock)
#   total      : ~4.2-5.6/min against the 60/min governor ceiling
# Before this change (warm 105m) it was ~8.9/min, so ~40% less, not the ~55% first
# claimed here — that figure wrongly counted a drift read as a single request.
#
# WARM_INTERVAL was set to 6h rather than the 11h the clamp would permit because past
# ~6h drift dominates and further warm increases buy little. For the same reason the
# next real lever is COUNCIL_DRIFT_INTERVAL, not this: 6h->12h drift would take the
# total to roughly 2.1-3.5/min. Weigh that against drift being the only detector of a
# permit changed directly in the council portal.
#
# A ~3-4h "failure" is far more likely a SESSION KICK than an idle timeout: signing
# in to the council portal in a browser with the same account invalidates our
# session. Rule that out before concluding the window shrank.
# COUNCIL_WARM_INTERVAL=6h

# The estimated idle window. It is NOT just documentation: it is the anchor for the
# keep-warm safety clamp (a session's warm threshold is never allowed within
# COUNCIL_WARM_SAFETY_MARGIN of it) and for the /status near-expiry metrics. Setting
# it BELOW the true window is safe but costly (it clamps the warm interval down and
# multiplies council traffic); setting it ABOVE the true window is the dangerous
# direction, so only raise it on evidence from the idle probe.
# COUNCIL_IDLE_WINDOW=12h
# COUNCIL_WARM_SAFETY_MARGIN=1h
# COUNCIL_EXPIRY_WARNING_MARGIN=2h
# How long an account may sit IDLE before we stop renewing and require a re-link.
# Bounds how long a departed household's plate can keep changing. The clock is
# reset by anyone on the account using the app (or clicking the confirm email),
# NOT by the anniversary of the original link, so an active household never hits
# it. A confirm email is sent as the deadline approaches.
# COUNCIL_SESSION_MAX_AGE_DAYS=90
# How many days before that deadline to email the one-click confirm link.
# COUNCIL_REMINDER_LEAD_DAYS=7

# --- Notifications (per-user: email and/or ntfy push) ---
# Users are told when their plate changes, and when a change fails. Delivery is
# best-effort, not a guarantee: transient failures wait for a short streak before
# anyone is told, quiet hours defer a notice to the morning, repeats are deduped,
# and a user who picks failures-only hears nothing on success. Users pick channels
# in Settings; only channels configured here are offered.
# Email: any SMTP provider (SES, Postmark, Fastmail, a local relay). Leave
# SMTP_HOST/SMTP_FROM empty to disable email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM is the visible sender. Prefer an informative, monitored-looking
# address over "no-reply" (the subject line already says what each email is).
# SMTP_FROM=p.stonn <notifications@example.com>
# ntfy push: point at your ntfy container (internal URL is fine). Each user gets
# a private auto-generated topic to subscribe to. Leave NTFY_BASE_URL empty to
# disable push. NTFY_TOKEN only if your ntfy server requires auth.
# NTFY_BASE_URL=http://ntfy:80
# NTFY_TOKEN=

# --- Admin alerts (systemic failures reach YOU, the operator) ---
# Where alerts go when something breaks that users can't fix: a council API-shape
# change, a notification that couldn't be delivered to a user, keep-warm
# collapse, a scheduler panic/stall, or DB errors. Both are tried so one being
# down (possibly the very failure) doesn't leave you blind. Strongly recommended;
# without either, systemic failures are only written to the logs.
# ADMIN_EMAIL needs SMTP configured above; ADMIN_NTFY_TOPIC needs NTFY_BASE_URL.
# Use a private, unguessable ntfy topic just for admin alerts.
# ADMIN_EMAIL=you@example.com
# ADMIN_NTFY_TOPIC=pstonn-admin-<random>

# --- Outage watchdog status endpoint ---
# STATUS_TOKEN gates the machine-readable /status endpoint (roster + health) that
# an EXTERNAL, independently-hosted dead-man's-switch polls to notify users if
# p.stonn goes down. Leave empty to disable the endpoint. Use a long random value
# and set the same token in the watchdog. The endpoint is public-by-route (bypasses
# login) but requires "Authorization: Bearer <token>".
# STATUS_TOKEN=<long-random-secret>   (>= 24 chars; the app refuses to start if shorter)
#
# ROSTER_KEY encrypts the user roster inside that response (64 hex chars, e.g.
# openssl rand -hex 32). The roster is every consented account's email plus their
# private push topic, so without this a leaked STATUS_TOKEN hands over the entire
# user list AND a live read capability on everyone's notifications. With it, the
# watchdog holds the same key and decrypts locally; a leaked token yields only
# ciphertext.
#
# REQUIRED whenever STATUS_TOKEN is set — the app refuses to start with one and
# not the other. There is no unencrypted roster any more, at all: earlier versions
# kept a plaintext fallback so the app could be deployed before the watchdog
# learned the sealed shape, and that fallback was the deployment shipping every
# user's address on every poll.
#
# The roster is also served ONLY when the caller asks for it
# (GET /status?roster=1), so the frequent health poll carries nothing sensitive.
# The watchdog must therefore request it explicitly and read "roster_sealed"; a
# watchdog that only polls plain /status and reads "roster" receives NO roster and
# will work from a stale cache without complaining, so update it FIRST, before
# setting these two here.
#
# Watchdog side (AES-256-GCM, 12-byte nonce prefixed, base64):
#   raw = base64.b64decode(resp["roster_sealed"])
#   roster = json.loads(AESGCM(bytes.fromhex(ROSTER_KEY)).decrypt(raw[:12], raw[12:], None))
# ROSTER_KEY=<64-hex-chars>
#
# The response also reports what the app believes about the caller:
#   "client": {"ip": "<address every per-IP throttle keys on>", "edge_proxy": "..."}
# edge_proxy is present only when a CDN forwarding header was seen, which means a
# proxy has been put in front of Caddy and every per-IP rate limit in the app has
# stopped limiting individuals. Have the watchdog alert on that field existing at
# all, and on "ip" not looking like a real client address.

# --- Capacity ---
# MAX_ACCOUNTS caps how many households may hold a linked council session
# (0 or unset = unlimited). Existing users are never affected — only a NEW link
# is refused, with a "we're full, get in touch" page.
#
# Why cap at all: the limit is CONVERGENCE LATENCY, not council load. Steady-state
# traffic is small — ~4.2-5.6 req/min at 500 accounts (the arithmetic is above, and
# drift at 3 requests an owner is the dominant term) against a 60/min ceiling. What binds
# is a shared roster boundary: every permit due at midnight drains through the one
# governor, so the last one lands late in proportion to the fleet — order an hour at
# 500-1000 permits with the defaults.
#
# The old "past fifty households" figure described per-permit sleep pacing that the
# global transport governor replaced; the number to watch now is the convergence
# bound the app LOGS at startup ("rollover spread: ... converges by ~X"), not this
# cap. Raising MAX_ACCOUNTS is fine while that bound stays inside what a roster can
# tolerate.
#
# If it does NOT, resist reaching for COUNCIL_GOV_RATE. Raising it is the one lever
# that increases requests per minute from our single egress IP, which is precisely
# the thing the whole design is arranged to avoid: the council edge throttles by
# source address, every household shares this one, and a soft block escalates when
# you keep pushing into it. Convergence latency is a delay; a shared-IP block is an
# outage for everyone at once. Prefer, in order: widen the rollover spread, accept
# slower convergence, or lower MAX_ACCOUNTS. Raise the governor rate only against
# measured headroom or an explicit agreement with the council — not to make a
# roster land sooner.
# MAX_ACCOUNTS=50

# --- Bounce / complaint feedback (AWS SES) ---
# SES_SNS_TOPIC_ARN enables POST /hooks/ses, which records addresses the mail
# provider reports as undeliverable (hard bounce) or that complained, and stops
# sending to them. Strongly recommended in production: without it the app keeps
# emailing dead addresses forever, which is the fastest way to lose a sending
# domain's reputation (SES will pause sending), and a user never learns that a
# guest's address was a typo. Leave empty to disable the endpoint entirely.
#
# Provision with:
#   python3 deploy/aws-ses-hook-setup.py --profile <p> --region <r> \
#     --domain <sending-domain> --app-url https://p.<domain>
# Run it twice: pass 1 prints this ARN, then add it here and redeploy so the app
# can accept the SNS subscription confirmation on pass 2.
#
# Only SES is wired up. On another provider, leave this unset — the app still
# classifies a hard SMTP rejection (5xx) at send time and suppresses that address.
# SES_SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:example-org-ses-events

# --- Contact form ---
# Where the public /contact form delivers to. Never shown to users; the form is
# only offered when this is set AND SMTP above is configured. Messages are sent
# via SMTP with the visitor's address (if given) as Reply-To. Use a private
# address here; it is not exposed publicly. Leave empty to hide the form.
# CONTACT_TO=you@example.com

# --- Misc ---
# Public base URL for every absolute link the app mints: the re-authorise confirm
# link in reminder emails, guest-pass links, the door QR. Defaults to
# https://p.<DOMAIN>, so on the scaffold (where the root .env supplies DOMAIN)
# there is nothing to set here. Must be an absolute http(s) URL with a host; the
# app refuses to start with neither this nor DOMAIN, because a missing base does
# not fail loudly — it produces relative links, which in an email are not links at
# all, and the confirm link is what stops a session lapsing.
# PUBLIC_BASE_URL=
# Optional path to a markdown terms file to use instead of the built-in one, so
# the sign-up agreement can be edited without rebuilding. Editing it (or bumping
# its `version:` line) re-prompts all users to accept. Mount the file read-only.
# TERMS_PATH=/data/terms.md
# Timezone rosters are interpreted in (local parking time).
DISPLAY_TIMEZONE=Australia/Melbourne
# Cookie Secure flag; true behind TLS. Set false only for local http dev.
COOKIE_SECURE=true
# LISTEN_ADDR=:8080
# SQLITE_PATH=/data/pstonn.db

# --- Local-only escape hatch (MUST be empty in production) ---
# Bypasses login for local runs without an auth layer: EVERY request becomes this
# address, in the admin group. The app refuses to start when it is set alongside
# DATA_ENCRYPTION_KEY, APP_OIDC_ISSUER, DOMAIN or a non-loopback PUBLIC_BASE_URL,
# but that is a tripwire on settings, not a proof of environment — on a host with
# none of them set this is still a wide-open app, so keep it out of anything
# reachable.
# DEV_IDENTITY_EMAIL=
