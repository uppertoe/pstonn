# pstonn restic backup config, files-only mode.
#
# This does NOT live in the pstonn repo's runtime; copy it into the SERVER repo as
#   backup/services/pstonn.env   (gitignored, mode 600)
# where the scaffold's restic runner auto-discovers it per run. Files-only means
# the whole named volume (the SQLite DB + encrypted council session) is snapshotted,
# so DB_NAME stays empty.
SERVICE_NAME=pstonn
RESTIC_REPOSITORY=s3:s3.ap-southeast-2.amazonaws.com/<your-backup-bucket>/backups/pstonn-backup
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))" (keep in a password manager)
RESTIC_PASSWORD=<generate-and-store>

# Files-only mode: leave DB_NAME empty.
# NOTE: the volume contains the LIVE SQLite db + WAL, which a file-level copy
# can catch mid-write. The app also writes a daily consistent snapshot
# (backup-snapshot.db, via VACUUM INTO) into the same volume — when restoring,
# prefer that file if the live pstonn.db won't open cleanly.
DB_NAME=
BACKUP_PATHS=/var/lib/docker/volumes/deploy_pstonn_data/_data
# Skip gracefully if the volume doesn't exist yet on a fresh host.
OPTIONAL=true

# Retention is NOT set here. The scaffold's restic runner applies it GLOBALLY
# from backup/config.env (KEEP_DAILY / KEEP_WEEKLY / KEEP_MONTHLY, defaulting to
# 7 / 4 / 6), running `restic forget` on the backup timer and `forget --prune` on
# the weekly verify timer. Setting per-service overrides here would silently
# diverge from the rest of the estate.
#
# It DOES matter what those values are, because they set the outer bound on how
# long data a user deleted from the app remains recoverable — and the privacy
# copy on /about states that bound out loud. With the defaults it is about six
# months (the monthly snapshots). Change one, change the other.
